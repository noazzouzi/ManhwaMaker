# Copier ce fichier en .env (ignore par git) et renseigner les cles.

# Plusieurs cles Gemini separees par des virgules : rotation automatique quand une cle est
# invalide / expiree ou que son quota journalier (RPD) est atteint sur le modele courant.
GEMINI_API_KEYS=cle_1,cle_2,cle_3

# Cascade de secours des modeles (facultatif). Quand toutes les cles echouent sur un modele,
# le gestionnaire passe au suivant ; chaque modele a son propre quota journalier, donc une
# cascade longue = plus de chapitres par jour et par cle. Sur ce compte, gemini-2.0-flash /
# 1.5-flash / 1.5-pro ne sont plus servis : la cascade par defaut enchaine les Flash, puis les
# Flash-Lite (quotas plus larges, qualite moindre), puis gemini-pro-latest.
# GEMINI_MODEL_CASCADE=gemini-3.5-flash,gemini-3.6-flash,gemini-3.7-flash,gemini-3.8-flash,gemini-2.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemini-pro-latest

# Modele prefere (equivalent de --model) : essaye en premier, la cascade suit.
# GEMINI_MODEL=gemini-3.5-flash

# --- Miniatures YouTube (module 7) ---------------------------------------------------------
# Backend de generation d'images : gemini (defaut, reutilise GEMINI_API_KEYS ci-dessus),
# stability, ou local. La miniature est desactivee par defaut dans le pipeline : l'activer
# avec --thumbnail, ou utiliser la commande dediee "python -m src.main thumbnail <dossier>".
# THUMBNAIL_IMAGE_BACKEND=gemini

# Backend stability : clef obligatoire, facturation separee de Gemini.
# STABILITY_API_KEY=sk-...
# STABILITY_URL=https://api.stability.ai/v2beta/stable-image/generate/core

# Backend local : serveur compatible AUTOMATIC1111 (txt2img).
# LOCAL_SD_URL=http://127.0.0.1:7860
